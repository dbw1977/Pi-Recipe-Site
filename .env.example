# Copy to .env and adjust. Never commit .env (CLAUDE.md rule 4).
# Chunk A needs none of these to run — sensible local defaults apply. They are here so
# the Pi deployment and later chunks (media on NAS, imports) are configured, not hardcoded.

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Data locality (GOLDEN RULE #1) ---
# The SQLite DB MUST live on the Pi's LOCAL disk. Never point this at a NAS/NFS/SMB mount.
RECIPE_DB_PATH=/home/pi/recipes/data/recipes.db

# --- Media (Chunk C) ---
# Originals may live on the NAS; mount it and point MEDIA_ROOT at the mount. Store only
# relative paths in the DB. Local default keeps everything self-contained for dev.
# MEDIA_ROOT=/media/recipes

# --- Frontend build location (usually leave default) ---
# FRONTEND_DIST=/home/pi/recipes/frontend/dist

# --- Places (Chunk D) ---
# HOME_CITY=

# ===========================================================================
# The keys below are NOT used in Chunk A. They are placeholders for Chunk B/C so
# you know what to set up. Leave them blank for now; features fail gracefully if unset.
# ===========================================================================
# ANTHROPIC_API_KEY=           # Chunk B — imports / vision / tagging (spec §10)
# GOOGLE_OAUTH_CLIENT_SECRET=  # Chunk B — Google Drive import (spec §5c)
# WHISPER_BIN=                 # Chunk B — voice transcription binary path
# WHISPER_MODEL=               # Chunk B — whisper.cpp model path
