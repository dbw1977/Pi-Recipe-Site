# Copy to .env and adjust. Never commit .env (CLAUDE.md rule 4).
# The manual app (Chunk A) needs none of these. The import features (Chunk B) each turn on
# only when their credential is present — a missing one disables just that path.

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Data locality (GOLDEN RULE #1) ---
# The SQLite DB MUST live on the Pi's LOCAL system disk. Never point this at a NAS/NFS/SMB
# share (network filesystems corrupt SQLite).
#   • Normal Raspberry Pi OS:     /home/pi/recipes/data/recipes.db
#   • OpenMediaVault / NAS boxes: home dirs often live on the storage pool, so use the
#     system disk explicitly. /var/lib/recipes works well (the systemd unit can create it
#     via StateDirectory=recipes). Example:
RECIPE_DB_PATH=/var/lib/recipes/recipes.db

# --- Media (originals; NAS mount wired in Chunk C) ---
# On import, remote images are downloaded here (never hot-linked). Relative paths go in the DB.
# MEDIA_ROOT=/media/recipes

# --- Frontend build location (usually leave default) ---
# FRONTEND_DIST=/home/pi/recipes/frontend/dist

# --- Places (Chunk D) ---
# HOME_CITY=

# ===========================================================================
# Chunk B — imports. Set these to enable the matching import path.
# ===========================================================================

# Anthropic (Claude) — enables screenshot import, voice structuring, and the URL AI-fallback
# for unsupported sites. URL import of SUPPORTED sites needs no key. (spec §10)
# ANTHROPIC_API_KEY=sk-ant-...
# Optional model overrides (defaults are sensible):
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_FALLBACK_MODEL=claude-sonnet-5

# whisper.cpp — enables voice-note transcription (kept fully local). (spec §5d)
# WHISPER_BIN=/home/pi/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL=/home/pi/whisper.cpp/models/ggml-base.en.bin

# Google Drive import — enables the "Scan Drive" bulk loader. (spec §5c)
# GOOGLE_CLIENT_SECRETS=/var/lib/recipes/google_client_secret.json
# GOOGLE_TOKEN_PATH=/var/lib/recipes/google_token.json   # created after you authorize
# DRIVE_FOLDER_ID=<the id from your Recipes folder's URL>
