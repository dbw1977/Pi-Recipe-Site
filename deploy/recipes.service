# systemd service for Pi Recipe Site. install.sh fills in your user name, the app folder and the port,
# and installs the result as /etc/systemd/system/recipes.service — you shouldn't need to edit it by hand.
#
# All settings (database path, photo folder, API keys, ...) live in the .env file in the app folder,
# not here, so the app and the command-line tools (python -m app.backup ...) always agree.
[Unit]
Description=Pi Recipe Site
After=network-online.target
Wants=network-online.target
# If the app folder is on a separate drive, don't start until that drive is mounted. (If the drive is
# missing at boot, systemd skips the start; recipes-retry.timer, installed by install.sh, tries again.)
RequiresMountsFor=@APP_DIR@

[Service]
User=@USER@
WorkingDirectory=@APP_DIR@/backend
ExecStart=@APP_DIR@/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port @PORT@
# Lets a normal user's process listen on port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Makes /var/lib/recipes (the library database, photos and thumbnails) and gives it to @USER@.
StateDirectory=recipes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
